DOCUMIND_DATABASE_URL=sqlite:///./data/documind.db
DOCUMIND_UPLOAD_DIR=./data/uploads
DOCUMIND_MAX_UPLOAD_MB=15
DOCUMIND_LOG_LEVEL=INFO
DOCUMIND_EXTRACTION_PROVIDER=rules
DOCUMIND_LEARNED_MODEL_PATH=./models/candidate_ranker.joblib
# Optional paid multimodal extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Configure current pricing explicitly to enable cost estimation; never inferred in code.
DOCUMIND_OPENAI_INPUT_COST_PER_MILLION=
DOCUMIND_OPENAI_OUTPUT_COST_PER_MILLION=
# Optional local VLM
DOCUMIND_OLLAMA_BASE_URL=http://localhost:11434
DOCUMIND_OLLAMA_MODEL=gemma3:4b
# Optional GPU models
DOCUMIND_HUGGINGFACE_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
DOCUMIND_LAYOUTLM_MODEL_PATH=./models/layoutlmv3-finetuned
